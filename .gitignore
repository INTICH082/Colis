**/node_modules/
.pnp/
.pnp.js

# Production build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/

# Vite / Bundler cache
.vite/
**/.vite/
.turbo/
.parcel-cache/

# TypeScript build info and emitted artifacts outside src
