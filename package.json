{
  "name": "colis-supermarket-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready networked store stocking simulator built with Three.js and Rapier3D",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync": "git pull --rebase --autostash origin main",
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace=@colis/server",
    "dev:client": "npm run dev --workspace=@colis/client",
    "build": "npm run build --workspace=@colis/shared && npm run build --workspace=@colis/server && npm run build --workspace=@colis/client",
    "build:launcher": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /target:exe /optimize+ /out:Colis.exe tools\\launcher\\Program.cs",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "threejs",
    "rapier3d",
    "multiplayer",
    "coop",
    "simulator"
  ],
  "author": "",
  "license": "MIT"
}
